<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GeneratorsCommon\GeneratorsCommon.csproj" />
        <ProjectReference Include="..\WebAPI_DSL_Lib\WebAPI_DSL_Lib.csproj" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
        <PackageReference Include="Scriban" Version="6.5.2" />  
    </ItemGroup>

    <ItemGroup>
      <None Update="Templates\AspDotNet\Controller.scriban-cs">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Templates\AspDotNet\DbContext.scriban-cs">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Templates\AspDotNet\Dto.scriban-cs">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Templates\AspDotNet\Entity.scriban-cs">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Templates\AspDotNet\Enums.scriban-cs">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <Target Name="CopyFilesToPluginDirectory" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <PluginDestination>..\WebAPI_DSL_Runtime\plugins\aspnet\</PluginDestination>
        </PropertyGroup>

        <ItemGroup>
            <PluginFiles Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json" />        
        </ItemGroup>

        <ItemGroup>
            <TemplateFiles Include=".\Templates\**\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDestination)" />
        <Copy SourceFiles="@(TemplateFiles)" DestinationFolder="$(PluginDestination)\Templates\%(RecursiveDir)" />
    </Target>

</Project>
